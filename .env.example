# Copy to .env and fill in as needed. Every value is optional: each integration stays a no-op
# until its variables are present, so the extension builds and runs with an empty .env.
#
# Only WXT_-prefixed variables are exposed to the extension bundle (via import.meta.env).

# The two endpoints the tracker core talks to: the DMarket API base URL, and the FE origin the
# marketplace token (dm-trade-token) is read + refreshed from.
WXT_DMARKET_API_BASE_URL=https://api.dmarket.com
WXT_DMARKET_FE_URL=https://dmarket.com/

# Internal dev/stage environments (same API + FE endpoint pairs, VPN-only), intentionally not
# committed. When set, non-production builds add them as host permissions / bridge origins, the
# debug console shows Dev/Stage prefill presets, and debug builds boot against the Dev pair.
# When unset, everything falls back to the production endpoints; production builds ignore these
# entirely either way.
WXT_DEV_API_URL=
WXT_DEV_FE_URL=
WXT_STAGE_API_URL=
WXT_STAGE_FE_URL=

# A local Steam stand-in, as an origin (e.g. http://localhost:8080). Steam's hosts are hard-coded in
# the tracker core, so the Steam-coupled flows (session refresh, trade send, cancel) otherwise need a
# live Steam account. When this is set, a non-production build sends every Steam request the core makes
# to this origin instead — in an ordinary browser window, with no launch flags — and adds it as a host
# permission. Unset (the default) means real Steam; production builds ignore it entirely.
#
# Only `fetch` is redirected: not cookies, not page navigations, not the on-page content script. The
# Steam session cookie is still read from the real steamcommunity.com origin, so a build using a
# stand-in needs that cookie set by hand before Steam reads as connected.
# See src/background/dev-steam-redirect.ts.
WXT_DEV_STEAM_URL=

# The notary service the TLSN prover attests through, as a WebSocket URL (wss://…). It REDIRECTS the
# prover; it is not the switch (the core defaults it to the production notary and gates the prover on the
# host's proof delegate), so pointing it somewhere unreachable fails proofs rather than skipping them.
#
# Non-production builds boot with this value, which is what points a dev build at a dev notary without
# touching the debug console. It is the LAST fallback, not the first: the debug console's notary field wins
# over it (an explicit clear included) and so does a published `tracker.notary.notaryUrl` — a substrate that
# publishes its own notary must keep it, and when this outranked a published value it cost a harness lane a
# false `UnknownIssuer` regression. PRODUCTION IGNORES IT ENTIRELY (`import.meta.env.DEV` is a compile-time
# constant, so the dev notary is never compiled into a shipped bundle); a released build carries the
# production notary as its compiled default instead, and leaving this unset simply points a dev build there
# too. See src/config/notaryUrl.ts.
#
# No host permission is needed — WebSockets aren't subject to CORS — but the dev notary usually lives on
# the same host as WXT_DEV_API_URL, which already contributes one.
WXT_DEV_NOTARY_URL=

# PEM root certificate(s) the TLSN prover verifies the PROVEN READ's certificate chain against. Unset
# (the default) keeps the prover on its bundled Mozilla web-PKI set, which is what production runs on.
#
# For a test substrate only: one that presents a leaf for api.steampowered.com signed by a fixture CA is
# correct for the notary and the validator, which both pin that root, and unprovable for the prover, which
# otherwise has no way to be told about it — a proof against such a substrate dies `UnknownIssuer`.
#
# DEV BUILDS ONLY, and deliberately NOT a remote-config value: this is a trust anchor, and a published one
# plus control of the byte pipe would let the prover accept a forged api.steampowered.com and attest it.
# The `import.meta.env.DEV` guard means production tree-shakes it out entirely.
WXT_DEV_NOTARY_ROOT_PEM=

# Registrable domain(s) the dev/stage session cookies are scoped to, comma-separated (no scheme, no
# leading dot) — e.g. the parent domain shared by the dev and stage FE hosts.
#
# Needed because Chrome checks cookie *events* and cookies.getAll against a URL derived from the
# COOKIE, not from the page: `(secure ? https : http)://<domain without leading dot>/`. A dev cookie
# scoped to a parent domain, or served without Secure, therefore fails the host-permission check even
# though the FE origin above is permitted — cookies.getAll silently omits it and cookies.onChanged
# never fires for it, so a dev login/logout is invisible to the extension (the tracker itself still
# works: cookies.get does not apply that filter). See src/background/refresh.ts.
#
# NOTE: the token refresh needs to WRITE these cookies, not just read them (the core rotates the DMarket
# token pair itself and the server does not Set-Cookie), and cookies.set is gated the same way as getAll.
# So on dev/stage this variable is effectively required for the refresh to work at all — without it the
# write is blind and the session cannot be kept alive, even though reads keep succeeding.
#
# Non-production builds only, and it grants access to every host under the domain over http AND https
# — so keep it to internal dev domains. Production builds ignore it entirely.
WXT_DEV_COOKIE_DOMAINS=

# Error collector — the shared DMarket Cloudflare Worker that also receives the web frontend's error
# reports (`POST <url>` with a JSON body; see src/infra/report/). Reporting is a complete no-op until this
# is set, so a public clone reports nowhere. Set it BEFORE cutting a release artifact: this URL becomes a
# host_permissions entry (narrowed to its own path), and adding a required host permission in a later
# update is a privilege increase — Chrome disables the extension until the user re-accepts, and on Firefox
# MV3 the host stays ungranted until the user answers a prompt. It is free now and expensive later.
WXT_COLLECTOR_URL=

# Optional dev/stage collector. Non-production builds prefer it; production ignores it entirely, and its
# path is added to host_permissions in non-production builds only.
WXT_DEV_COLLECTOR_URL=

# Firebase Remote Config (fetched over the public REST API — no remote code). Drives the single
# `p2p_tracker_config` JSON parameter that overlays scraping / banner / timing config over the
# compiled-in defaults (see src/config/settings.ts). When all three are set, wxt.config.ts adds the
# firebaseremoteconfig host permission automatically. Setup + the config-document schema are documented
# in an internal setup guide (not committed).
#
# API key / project id / app id are PUBLIC client identifiers — and are baked into the shipped bundle,
# so they aren't secret. Keep them out of the committed source anyway (this .env is gitignored). Never
# put anything sensitive into a Remote Config value: it is delivered verbatim to every client.
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_APP_ID=
