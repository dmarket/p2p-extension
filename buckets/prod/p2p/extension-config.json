      "getSteamLevelPath": "/IPlayerService/GetSteamLevel/v1/",
      "historyMaxTrades": 50,
      "bulkOfferThreshold": 1
    },
    "steamScrape": {
      "tokenRegex": "data-loyalty_webapi_token=\"&quot;([a-zA-Z0-9_.\\-]+)&quot;",
      "steamIdRegex": "g_steamID\\s*=\\s*\"(\\d+)\"",
      "steamSessionCookieName": "steamLoginSecure",
      "steamSessionIdCookieName": "sessionid"
    }
  },
  "web": {
    "bannerAnchorSelector": ".maincontent",
    "logoutExpression": "Logout();",
    "tradeOffersUrl": "https://steamcommunity.com/my/tradeoffers",
    "steamLoginUrl": "https://steamcommunity.com/login/home/?goto=my%2Ftradeoffers",
    "activeBannerLink": "https://dmarket.com/ingame-items/item-list/csgo-skins",
    "antiCsrf": [
