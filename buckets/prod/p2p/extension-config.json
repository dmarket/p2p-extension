      },
      {
        "ruleId": 2,
        "host": "steamcommunity.com",
        "path": "/login/settoken",
        "site": "community"
      },
      {
        "ruleId": 3,
        "host": "store.steampowered.com",
        "path": "/login/settoken",
        "site": "store"
      },
      {
        "ruleId": 5,
        "host": "login.steampowered.com",
        "path": "/jwt/ajaxrefresh",
        "site": "community"
      }
    ],
    "notaryProofTimeoutMs": 180000,
    "notaryStuckAfterMs": 25000,
    "notaryProofsPerInstance": 5,
    "remoteConfigFetchIntervalMs": 3600000,
    "minExtensionVersion": "1.0.6",
    "dmarketUrl": "https://dmarket.com/",
    "errorReporting": {
      "enabled": true,
      "maxPerDay": 10,
      "maxPerDayFromPage": 3,
      "fpCooldownMs": 1800000,
      "suppressSubstrings": []
    }
