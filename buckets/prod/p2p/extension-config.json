    "credentials": {
      "steamSkewMs": 60000,
      "marketplaceSkewMs": 60000,
      "sessionGateHeadroomMs": 3600000,
      "marketplaceSessionGateHeadroomMs": 600000,
      "marketplaceRefreshMinLifeMs": 60000,
      "marketplaceRefreshMinIntervalMs": 60000
    },
    "http": {
      "requestTimeoutMs": 30000
    },
    "marketplaceRetry": {
      "maxRetries": 3,
      "retryBaseDelayMs": 500,
      "retryMaxDelayMs": 8000
    },
    "marketplaceScrape": {
      "cookieName": "dm-trade-token",
      "refreshCookieName": "dm-trade-refresh-token",
      "tokenRefreshPath": "/marketplace-api/v1/refresh-token",
      "deferRefreshWhileSiteTabOpen": false
    },
    "steamEndpoints": {
      "getTradeOfferPath": "/IEconService/GetTradeOffer/v1/",
      "getTradeOffersPath": "/IEconService/GetTradeOffers/v1/",
      "getTradeHistoryPath": "/IEconService/GetTradeHistory/v1/",
